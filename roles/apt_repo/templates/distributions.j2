# Ark reprepro distributions config
# Generated by Ansible — do not edit manually.
# Changes will be overwritten on next playbook run.
{% for dist in ark_distributions %}

Origin: {{ dist.origin | default('Ark') }}
Label: {{ dist.label }}
Codename: {{ dist.codename }}
Architectures: {{ ark_architectures | join(' ') }}
Components: main
Description: Ark offline repository — {{ dist.label }}
{% if ark_sign_repo %}
SignWith: {{ ark_gpg_key_email }}
{% endif %}
{% endfor %}
